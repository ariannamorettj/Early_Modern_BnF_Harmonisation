{
    "id": "actors",
    "endpoint": {
        "url": "SPARQL_ENDPOINT",
        "useAuth": false,
        "prefixesFile": "SparqlQueriesPrefixes.js"
    },
    "sparqlQueriesFile": "SparqlQueriesActors.js",
    "generalQueries": {
        "facetResultSetQuery": "facetResultSetQueryLateral"
    },
    "baseURI": "http://data.bnf.fr/ark:/12148",
    "URITemplate": "<BASE_URI>/<LOCAL_ID>#about",
    "facetClass": "obj:Person obj:Organization",
    "frontPageImage": "main_page/actors.svg",
    "searchMode": "faceted-search",
    "enableDynamicLanguageChange": false,
    "defaultActiveFacets": [
        "prefLabel"
    ],
    "defaultTab": "table",
    "defaultInstancePageTab": "table",
    "resultClasses": {
        "actors": {
            "paginatedResultsConfig": {
                "tabID": 0,
                "component": "ResultTable",
                "tabPath": "table",
                "tabIcon": "CalendarViewDay",
                "propertiesQueryBlock": "actorProperties",
                "pagesize": 20,
                "sortBy": "prefLabel",
                "sortDirection": "asc"
            },
            "instanceConfig": {
                "propertiesQueryBlock": "actorProperties",
                "instancePageResultClasses": {
                    "instancePageTable": {
                        "tabID": 0,
                        "component": "InstancePageTable",
                        "tabPath": "table",
                        "tabIcon": "CalendarViewDay"
                    },
                    "instancePageExport": {
                        "tabID": 1,
                        "component": "Export",
                        "tabPath": "export",
                        "tabIcon": "CloudDownload",
                        "pageType": "instancePage"
                    }
                }
            }
        },
        "actorBirthsByDecade": {
            "tabID": 1,
            "component": "ApexCharts",
            "tabPath": "births_by_decade",
            "tabIcon": "ShowChart",
            "sparqlQuery": "actorBirthsByDecadeQuery",
            "facetClass": "actors",
            "filterTarget": "actor",
            "resultMapper": "mapLineChart",
            "resultMapperConfig": {
                "fillEmptyValues": false
            },
            "createChartData": "createSingleLineChartData",
            "title": "Actors by decade of birth",
            "xaxisTitle": "Decade",
            "xaxisType": "category",
            "xaxisTickAmount": 30,
            "yaxisTitle": "Actors",
            "seriesTitle": "Actors",
            "stroke": {
                "curve": "straight",
                "width": 2
            }
        },
        "export": {
            "tabID": 2,
            "component": "Export",
            "tabPath": "export",
            "tabIcon": "CloudDownload",
            "resultClass": "actors",
            "facetClass": "actors"
        }
    },
    "maps": {},
    "properties": [
        {
            "id": "uri",
            "valueType": "object",
            "makeLink": true,
            "externalLink": true,
            "sortValues": true,
            "numberedList": false,
            "onlyOnInstancePage": true
        },
        {
            "id": "prefLabel",
            "valueType": "object",
            "makeLink": true,
            "externalLink": false,
            "sortValues": true,
            "numberedList": false,
            "minWidth": 220
        },
        {
            "id": "type",
            "valueType": "object",
            "makeLink": false,
            "externalLink": false,
            "sortValues": true,
            "numberedList": false,
            "minWidth": 100
        },
        {
            "id": "birthYear",
            "valueType": "string",
            "makeLink": false,
            "externalLink": false,
            "sortValues": true,
            "numberedList": false,
            "minWidth": 70
        },
        {
            "id": "deathYear",
            "valueType": "string",
            "makeLink": false,
            "externalLink": false,
            "sortValues": true,
            "numberedList": false,
            "minWidth": 70
        },
        {
            "id": "gender",
            "valueType": "object",
            "makeLink": false,
            "externalLink": false,
            "sortValues": true,
            "numberedList": false,
            "minWidth": 70
        },
        {
            "id": "country",
            "valueType": "object",
            "makeLink": false,
            "externalLink": false,
            "sortValues": true,
            "numberedList": false,
            "minWidth": 100
        },
        {
            "id": "role",
            "valueType": "object",
            "makeLink": false,
            "externalLink": false,
            "sortValues": true,
            "numberedList": false,
            "minWidth": 100
        },
        {
            "id": "edition",
            "valueType": "object",
            "makeLink": true,
            "externalLink": false,
            "sortValues": true,
            "numberedList": true,
            "minWidth": 300
        },
        {
            "id": "externalLink",
            "valueType": "object",
            "makeLink": true,
            "externalLink": true,
            "sortValues": true,
            "numberedList": false,
            "onlyOnInstancePage": true
        }
    ],
    "facets": {
        "prefLabel": {
            "containerClass": "one",
            "facetType": "text",
            "filterType": "textFilter",
            "textQueryType": "regex",
            "textQueryProperty": "skos:prefLabel",
            "sortByPredicate": "skos:prefLabel"
        },
        "type": {
            "containerClass": "three",
            "facetType": "list",
            "filterType": "uriFilter",
            "predicate": "bnfp:actorType",
            "pieChartButton": true,
            "sortBy": "instanceCount",
            "sortByPredicate": "bnfp:actorType/skos:prefLabel",
            "sortDirection": "desc"
        },
        "role": {
            "containerClass": "four",
            "facetType": "list",
            "filterType": "uriFilter",
            "predicate": "bnfp:role",
            "pieChartButton": true,
            "sortBy": "instanceCount",
            "sortByPredicate": "bnfp:role/skos:prefLabel",
            "sortDirection": "desc"
        },
        "gender": {
            "containerClass": "three",
            "facetType": "list",
            "filterType": "uriFilter",
            "predicate": "bnfp:gender",
            "pieChartButton": true,
            "sortBy": "instanceCount",
            "sortByPredicate": "bnfp:gender/skos:prefLabel",
            "sortDirection": "desc",
            "labelPattern": "OPTIONAL { ?id skos:prefLabel ?prefLabel_ } BIND(COALESCE(STR(?prefLabel_), REPLACE(STR(?id), \"^.*/\", \"\")) AS ?prefLabel)"
        },
        "country": {
            "containerClass": "ten",
            "facetType": "list",
            "filterType": "uriFilter",
            "predicate": "bnfp:country",
            "searchField": true,
            "sortButton": true,
            "barChartButton": true,
            "sortBy": "instanceCount",
            "sortByPredicate": "bnfp:country/skos:prefLabel",
            "sortDirection": "desc",
            "labelPattern": "OPTIONAL { ?id skos:prefLabel ?prefLabel_ } BIND(COALESCE(STR(?prefLabel_), REPLACE(STR(?id), \"^.*/\", \"\")) AS ?prefLabel)"
        },
        "birthYear": {
            "containerClass": "five",
            "facetType": "integer",
            "filterType": "integerFilterRange",
            "predicate": "bnfp:birthYear",
            "sortByPredicate": "bnfp:birthYear",
            "unit": ""
        },
        "deathYear": {
            "containerClass": "five",
            "facetType": "integer",
            "filterType": "integerFilterRange",
            "predicate": "bnfp:deathYear",
            "sortByPredicate": "bnfp:deathYear",
            "unit": ""
        },
        "edition": {
            "sortByPredicate": "bnfp:contributedTo/skos:prefLabel"
        }
    }
}
